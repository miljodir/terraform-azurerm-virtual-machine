run "identity_and_roles" {
  command   = apply
  state_key = "identity"

  variables {
    enable_managed_identity = true
    managed_identity_roles = {
      reader = {
        role_definition_name = "Reader"
        scope                = "/subscriptions/00000000-0000-0000-0000-000000000000"
      }
    }
  }

  assert {
    condition     = azurerm_windows_virtual_machine.win_vm[0].identity[0].type == "SystemAssigned"
    error_message = "A system-assigned identity should be enabled."
  }

  assert {
    condition     = azurerm_role_assignment.role["reader"].principal_id == azurerm_windows_virtual_machine.win_vm[0].identity[0].principal_id
    error_message = "Roles should be assigned to the VM identity."
  }
}

run "extensions" {
  command = apply

  variables {
    enable_aad_login       = true
    enable_disk_encryption = true
    custom_script_extension = {
      command_to_execute = "powershell -File example.ps1"
      script_urls        = ["https://example.com/example.ps1"]
    }
  }

  assert {
    condition     = azurerm_virtual_machine_extension.aad_extension_windows[0].type == "AADLoginForWindows"
    error_message = "The Windows AAD login extension should be installed."
  }

  assert {
    condition     = azurerm_virtual_machine_extension.disk_encryption_windows[0].type_handler_version == "2.2"
    error_message = "Windows disk encryption should default to handler version 2.2."
  }

  assert {
    condition     = azurerm_virtual_machine_extension.custom_script_extension[0].publisher == "Microsoft.Compute"
    error_message = "Windows VMs should use the Microsoft.Compute custom script extension."
  }

  assert {
    condition     = length(azurerm_virtual_machine_extension.aad_extension_linux) == 0 && length(azurerm_virtual_machine_extension.disk_encryption_linux) == 0
    error_message = "Linux extensions should not be installed on Windows VMs."
  }
}

run "linux_extensions" {
  command = apply

  variables {
    os_flavor              = "linux"
    enable_aad_login       = true
    enable_disk_encryption = true
    custom_script_extension = {
      command_to_execute = "sh example.sh"
      script_urls        = ["https://example.com/example.sh"]
    }
  }

  assert {
    condition     = azurerm_virtual_machine_extension.aad_extension_linux[0].type == "AADSSHLoginForLinux"
    error_message = "The Linux AAD SSH login extension should be installed."
  }

  assert {
    condition     = azurerm_virtual_machine_extension.disk_encryption_linux[0].type_handler_version == "1.1"
    error_message = "Linux disk encryption should default to handler version 1.1."
  }

  assert {
    condition     = azurerm_virtual_machine_extension.custom_script_extension[0].publisher == "Microsoft.Azure.Extensions"
    error_message = "Linux VMs should use the Microsoft.Azure.Extensions custom script extension."
  }
}

