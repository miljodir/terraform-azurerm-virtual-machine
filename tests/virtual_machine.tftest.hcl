mock_provider "azurerm" {
  mock_resource "azurerm_windows_virtual_machine" {
    defaults = {
      id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-test/providers/Microsoft.Compute/virtualMachines/vm-test"
    }
  }

  mock_resource "azurerm_linux_virtual_machine" {
    defaults = {
      id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-test/providers/Microsoft.Compute/virtualMachines/vm-test"
    }
  }

  mock_resource "azurerm_managed_disk" {
    defaults = {
      id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-test/providers/Microsoft.Compute/disks/disk-test"
    }
  }

  mock_resource "azurerm_network_interface" {
    defaults = {
      id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-test/providers/Microsoft.Network/networkInterfaces/nic-test"
    }
  }
}

mock_provider "random" {
  # Mock values are random strings; the VM resource validates password complexity.
  mock_resource "random_password" {
    defaults = {
      result = "NotARealPassword-123"
    }
  }
}
mock_provider "tls" {
  # Throwaway public key (private key discarded) so the VM resource's key validation passes.
  mock_resource "tls_private_key" {
    defaults = {
      public_key_openssh = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIL8l+Dmsu+JQOZ1BelXXfo99qLxo81XqASgEbHQ8L/xI test"
    }
  }
}

variables {
  resource_group_name  = "rg-test"
  virtual_machine_name = "vm-test"
  subnet_id            = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-test/providers/Microsoft.Network/virtualNetworks/vnet-test/subnets/snet-test"
  # Power actions are tested separately in plan mode.
  vm_power_action = null
}

run "windows_defaults" {
  command = apply

  assert {
    condition     = length(azurerm_windows_virtual_machine.win_vm) == 1 && length(azurerm_linux_virtual_machine.linux_vm) == 0
    error_message = "A Windows VM should be created by default."
  }

  assert {
    condition     = azurerm_network_interface.nic.name == "vm-test-nic"
    error_message = "NIC name should default to '<vm>-nic'."
  }

  assert {
    condition     = azurerm_network_interface.nic.ip_configuration[0].private_ip_address_allocation == "Dynamic"
    error_message = "Private IP allocation should default to Dynamic."
  }

  assert {
    condition     = azurerm_windows_virtual_machine.win_vm[0].source_image_reference[0].sku == "2025-datacenter-azure-edition"
    error_message = "Windows Server 2025 Azure Edition should be the default image."
  }

  assert {
    condition     = azurerm_windows_virtual_machine.win_vm[0].os_disk[0].name == "vm-test-osdisk"
    error_message = "OS disk name should default to '<vm>-osdisk'."
  }

  assert {
    condition     = azurerm_windows_virtual_machine.win_vm[0].encryption_at_host_enabled == true
    error_message = "Encryption at host should be enabled by default."
  }

  assert {
    condition     = azurerm_windows_virtual_machine.win_vm[0].secure_boot_enabled == true && azurerm_windows_virtual_machine.win_vm[0].vtpm_enabled == true
    error_message = "Secure boot and vTPM should be enabled by default."
  }

  assert {
    condition     = azurerm_windows_virtual_machine.win_vm[0].patch_mode == "AutomaticByPlatform"
    error_message = "Patch mode should default to AutomaticByPlatform."
  }

  assert {
    condition     = length(random_password.passwd) == 1
    error_message = "A password should be generated when admin_password is not set."
  }

  assert {
    condition     = length(azurerm_windows_virtual_machine.win_vm[0].identity) == 0
    error_message = "No managed identity should be enabled by default."
  }

  assert {
    condition     = length(tls_private_key.rsa) == 0
    error_message = "No SSH key should be generated for Windows VMs."
  }
}

run "windows_with_admin_password" {
  command = plan

  variables {
    admin_password = "NotARealPassword-123"
  }

  assert {
    condition     = length(random_password.passwd) == 0
    error_message = "No password should be generated when admin_password is set."
  }
}

run "linux_defaults" {
  command = apply

  variables {
    os_flavor = "linux"
  }

  assert {
    condition     = length(azurerm_linux_virtual_machine.linux_vm) == 1 && length(azurerm_windows_virtual_machine.win_vm) == 0
    error_message = "A Linux VM should be created when os_flavor = linux."
  }

  assert {
    condition     = azurerm_linux_virtual_machine.linux_vm[0].source_image_reference[0].offer == "ubuntu-24_04-lts"
    error_message = "Ubuntu 24.04 should be the default Linux image."
  }

  assert {
    condition     = length(tls_private_key.rsa) == 1 && tls_private_key.rsa[0].algorithm == "ED25519"
    error_message = "An ED25519 SSH key should be generated by default."
  }

  assert {
    condition     = length(random_password.passwd) == 0
    error_message = "No password should be generated when password authentication is disabled."
  }

  assert {
    condition     = output.admin_ssh_key_public == tls_private_key.rsa[0].public_key_openssh
    error_message = "The generated public key should be exposed as an output."
  }
}

run "linux_password_authentication" {
  command = plan

  variables {
    os_flavor                       = "linux"
    disable_password_authentication = false
  }

  assert {
    condition     = length(random_password.passwd) == 1
    error_message = "A password should be generated when password authentication is enabled."
  }
}

run "custom_image_and_names" {
  command = plan

  variables {
    custom_image = {
      publisher = "ExamplePublisher"
      offer     = "example-offer"
      sku       = "example-sku"
    }
    nic_name                           = "nic-custom"
    os_disk_name                       = "osdisk-custom"
    private_ip_address_allocation_type = "Static"
    private_ip_address                 = "10.0.0.10"
  }

  assert {
    condition     = azurerm_windows_virtual_machine.win_vm[0].source_image_reference[0].publisher == "ExamplePublisher" && azurerm_windows_virtual_machine.win_vm[0].source_image_reference[0].version == "latest"
    error_message = "custom_image should override the predefined images."
  }

  assert {
    condition     = azurerm_network_interface.nic.name == "nic-custom"
    error_message = "nic_name should override the generated NIC name."
  }

  assert {
    condition     = azurerm_windows_virtual_machine.win_vm[0].os_disk[0].name == "osdisk-custom"
    error_message = "os_disk_name should override the generated OS disk name."
  }

  assert {
    condition     = azurerm_network_interface.nic.ip_configuration[0].private_ip_address == "10.0.0.10"
    error_message = "Static private IP should be passed through."
  }
}

run "datadisks" {
  command = apply

  variables {
    availability_zone = 1
    datadisks = {
      data = {
        size    = "128"
        type    = "Premium_LRS"
        caching = "ReadOnly"
        lun     = 0
      }
      logs = {
        size          = "64"
        type          = "StandardSSD_LRS"
        caching       = "None"
        lun           = 1
        override_name = "disk-logs"
      }
    }
  }

  assert {
    condition     = azurerm_managed_disk.datadisks_create["data"].name == "vm-test-datadisk0"
    error_message = "Data disk names should default to '<vm>-datadisk<lun>'."
  }

  assert {
    condition     = azurerm_managed_disk.datadisks_create["logs"].name == "disk-logs"
    error_message = "override_name should override the generated data disk name."
  }

  assert {
    condition     = azurerm_managed_disk.datadisks_create["data"].zone == "1"
    error_message = "Data disks should be placed in the VM's availability zone."
  }

  assert {
    condition     = azurerm_virtual_machine_data_disk_attachment.datadisks_attach["logs"].lun == 1
    error_message = "Data disks should be attached on the given LUN."
  }
}

run "windows_identity_disabled" {
  command   = apply
  state_key = "windows_identity"

  assert {
    condition     = length(azurerm_windows_virtual_machine.win_vm[0].identity) == 0
    error_message = "The existing Windows VM must start without an identity."
  }
}

run "windows_enable_existing_identity_plan" {
  command   = plan
  state_key = "windows_identity"

  variables {
    enable_managed_identity = true
    secure_boot_enabled     = false
    vtpm_enabled            = false
  }

  assert {
    condition     = try(azurerm_windows_virtual_machine.win_vm[0].identity[0].type == "SystemAssigned", false)
    error_message = "Enabling identity must appear in the plan for an existing Windows VM."
  }

  assert {
    condition     = azurerm_windows_virtual_machine.win_vm[0].secure_boot_enabled && azurerm_windows_virtual_machine.win_vm[0].vtpm_enabled
    error_message = "Enabling identity must preserve the Windows secure boot and vTPM lifecycle exclusions."
  }
}

run "windows_enable_existing_identity_apply" {
  command   = apply
  state_key = "windows_identity"

  variables {
    enable_managed_identity = true
  }

  assert {
    condition     = try(azurerm_windows_virtual_machine.win_vm[0].identity[0].type == "SystemAssigned", false)
    error_message = "Applying enabled identity must update the existing Windows VM."
  }
}

